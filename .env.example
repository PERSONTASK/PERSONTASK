# ── PERSONTASK — variáveis de ambiente (frontend) ─────────────────────
# Copie este arquivo para `.env` e preencha com as chaves do seu projeto Supabase.
# (Settings → API no painel do Supabase.)

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# URL pública do app (usada em links de convite dentro dos e-mails).
VITE_APP_URL=http://localhost:5173

# ── Segredos das Edge Functions (NÃO vão no frontend) ─────────────────
# Configure-os com: supabase secrets set NOME=valor
#   RESEND_API_KEY=...............   (provedor de e-mail transacional)
#   EMAIL_FROM="PERSONTASK <no-reply@seudominio.com>"
#   APP_URL=https://app.seudominio.com
#   SUPABASE_SERVICE_ROLE_KEY=...    (injetado automaticamente nas functions)
